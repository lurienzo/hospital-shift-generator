# Impronta SHA-256 della password di accesso all'applicazione.
#
# Se questa variabile non e impostata, l'applicazione si apre senza
# chiedere nulla: e il comportamento voluto in sviluppo e nei test.
#
# Per generarla:  node tools/hash-password.mjs "la mia password"
# Copia il risultato in .env.local, che git ignora.
#
# Non e una misura di sicurezza: l'applicazione gira nel browser, quindi
# l'impronta viene scaricata insieme alla pagina. Tiene fuori chi capita
# sull'indirizzo per caso, non chi vuole davvero entrare.
VITE_APP_PASSWORD_SHA256=
